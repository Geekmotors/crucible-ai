                }
              ]
            }
          }
        ]
      },
      "expect": {
        "text": "created"
      }
    },
    {
      "id": "provider-response-success-null-error-member",
      "description": "An error member holding null is ignored.",
      "input": {
        "responses": [
          {
            "status": 200,
            "json": {
              "error": null,
              "choices": [
                {
                  "message": {
                    "content": "fine"
                  }
                }
              ]
            }
          }
        ]
      },
      "expect": {
        "text": "fine"
      }
    },
