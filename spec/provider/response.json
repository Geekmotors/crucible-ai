{
  "area": "provider",
  "operation": "response",
  "description": "Turns the HTTP responses of one judge call's attempts into the judge's reply text or an error.",
  "cases": [
    {
      "id": "provider-response-success",
      "description": "A 200 envelope yields choices[0].message.content exactly, white space kept.",
      "input": {
        "responses": [
          {
            "status": 200,
            "json": {
              "choices": [
                {
                  "message": {
                    "role": "assistant",
                    "content": "  {\"verdict\": true, \"reasoning\": \"consistent\"}\n"
                  }
                }
              ]
            }
          }
        ]
      },
      "expect": {
        "text": "  {\"verdict\": true, \"reasoning\": \"consistent\"}\n"
      }
    },
    {
      "id": "provider-response-success-empty-content",
      "description": "Empty content is a reply (whether it is usable is judge/reply's business).",
      "input": {
        "responses": [
          {
            "status": 200,
            "json": {
              "choices": [
                {
                  "message": {
                    "role": "assistant",
                    "content": ""
                  }
                }
              ]
            }
          }
        ]
      },
      "expect": {
        "text": ""
      }
    },
    {
      "id": "provider-response-success-extra-fields",
      "description": "Other envelope members (id, usage, extra choices) are ignored; only the first choice counts.",
      "input": {
        "responses": [
          {
            "status": 200,
            "json": {
              "id": "gen-1",
              "usage": {
                "cost": 0.0001
              },
              "choices": [
                {
                  "index": 0,
                  "finish_reason": "stop",
                  "message": {
                    "role": "assistant",
                    "content": "first"
                  }
                },
                {
                  "message": {
                    "content": "second"
                  }
                }
              ]
            }
          }
        ]
      },
      "expect": {
        "text": "first"
      }
    },
    {
      "id": "provider-response-success-other-2xx",
      "description": "Any 2xx status is a success.",
      "input": {
        "responses": [
          {
            "status": 201,
            "json": {
              "choices": [
                {
                  "message": {
                    "role": "assistant",
