{
  "area": "judge",
  "operation": "reply",
  "description": "Reads the judge's reply text of a coherent or extract call into its result, asking once more after an unusable reply.",
  "cases": [
    {
      "id": "judge-reply-coherent-true",
      "description": "A strict JSON reply with verdict true.",
      "input": {
        "ask": "coherent",
        "replies": ["{\"verdict\":true,\"reasoning\":\"consistent\"}"]
      },
      "expect": {
        "value": {
          "verdict": true,
          "reasoning": "consistent"
        }
      }
    },
    {
      "id": "judge-reply-coherent-false",
      "description": "A strict JSON reply with verdict false.",
      "input": {
        "ask": "coherent",
        "replies": ["{\"verdict\":false,\"reasoning\":\"contradiction\"}"]
      },
      "expect": {
        "value": {
          "verdict": false,
          "reasoning": "contradiction"
        }
      }
    },
    {
      "id": "judge-reply-coherent-key-order",
      "description": "Key order does not matter.",
      "input": {
        "ask": "coherent",
        "replies": ["{\"reasoning\":\"r\",\"verdict\":true}"]
      },
      "expect": {
        "value": {
          "verdict": true,
          "reasoning": "r"
        }
      }
    },
    {
      "id": "judge-reply-coherent-white-space",
      "description": "White space around the JSON is ignored.",
      "input": {
