        "replies": ["\n\n   {\"verdict\":true,\"reasoning\":\"padded\"}  \n"]
      },
      "expect": {
        "value": {
          "verdict": true,
          "reasoning": "padded"
        }
      }
    },
    {
      "id": "judge-reply-coherent-pretty-printed",
