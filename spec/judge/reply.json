      "input": {
        "ask": "coherent",
        "replies": ["{\n  \"verdict\": false,\n  \"reasoning\": \"multi\\nline\"\n}"]
      },
      "expect": {
        "value": {
          "verdict": false,
          "reasoning": "multi\nline"
        }
      }
    },
    {
      "id": "judge-reply-coherent-byte-order-mark",
