{
  "area": "assertion",
  "operation": "call",
  "description": "Validates the arguments of crucible.facts, crucible.coherent and crucible.extract (and t.*) the way a test body calls them, and builds the user message they send: call options reach the payload (facts after the run's facts, as → TYPE, strict → MODE), invalid arguments are usage errors.",
  "cases": [
    {
      "id": "assertion-call-coherent-arguments-only",
      "description": "A coherent call with no options sends the response and claim alone.",
      "input": {
        "assertion": "coherent",
        "args": ["The meeting is at six.", "The reply names a time"]
      },
      "expect": {
        "text": "RESPONSE\n<<<\nThe meeting is at six.\n>>>\n\nCLAIM\n<<<\nThe reply names a time\n>>>"
      }
    },
    {
      "id": "assertion-call-coherent-options-unset",
      "description": "Unset options are the same as none.",
      "input": {
        "assertion": "coherent",
        "args": [
          "The meeting is at six.",
          "The reply names a time",
          {
            "$special": "undefined"
          }
        ]
      },
      "expect": {
        "text": "RESPONSE\n<<<\nThe meeting is at six.\n>>>\n\nCLAIM\n<<<\nThe reply names a time\n>>>"
      }
    },
    {
      "id": "assertion-call-coherent-empty-options",
      "description": "Empty options are the same as none.",
      "input": {
        "assertion": "coherent",
        "args": ["The meeting is at six.", "The reply names a time", {}]
      },
      "expect": {
        "text": "RESPONSE\n<<<\nThe meeting is at six.\n>>>\n\nCLAIM\n<<<\nThe reply names a time\n>>>"
      }
    },
    {
      "id": "assertion-call-coherent-facts-string",
      "description": "A facts string is one fact for this call.",
      "input": {
        "assertion": "coherent",
        "args": [
          "The meeting is at six.",
          "The reply names a time",
          {
            "facts": "The user asked at noon."
          }
        ]
      },
      "expect": {
        "text": "STATE\n<<<\nThe user asked at noon.\n>>>\n\nRESPONSE\n<<<\nThe meeting is at six.\n>>>\n\nCLAIM\n<<<\nThe reply names a time\n>>>"
      }
    },
    {
      "id": "assertion-call-coherent-facts-array",
      "description": "A facts array gives one fact per entry, in order.",
      "input": {
        "assertion": "coherent",
        "args": [
          "The meeting is at six.",
          "The reply names a time",
          {
            "facts": ["First.", "Second."]
          }
        ]
      },
      "expect": {
        "text": "STATE\n<<<\nFirst.\nSecond.\n>>>\n\nRESPONSE\n<<<\nThe meeting is at six.\n>>>\n\nCLAIM\n<<<\nThe reply names a time\n>>>"
      }
    },
    {
      "id": "assertion-call-coherent-facts-empty-array",
      "description": "An empty facts array adds no fact and no STATE section.",
      "input": {
        "assertion": "coherent",
        "args": [
          "The meeting is at six.",
          "The reply names a time",
          {
            "facts": []
          }
        ]
      },
      "expect": {
        "text": "RESPONSE\n<<<\nThe meeting is at six.\n>>>\n\nCLAIM\n<<<\nThe reply names a time\n>>>"
      }
    },
    {
      "id": "assertion-call-coherent-facts-unset",
      "description": "Unset facts are the same as none.",
      "input": {
        "assertion": "coherent",
        "args": [
          "The meeting is at six.",
          "The reply names a time",
          {
            "facts": {
              "$special": "undefined"
            }
          }
        ]
      },
      "expect": {
        "text": "RESPONSE\n<<<\nThe meeting is at six.\n>>>\n\nCLAIM\n<<<\nThe reply names a time\n>>>"
      }
    },
    {
      "id": "assertion-call-coherent-run-facts",
      "description": "Each facts call adds its string or array entries to the run, in call order.",
      "input": {
        "assertion": "coherent",
        "facts": ["One.", ["Two.", "Three."]],
        "args": ["The meeting is at six.", "The reply names a time"]
      },
      "expect": {
        "text": "STATE\n<<<\nOne.\nTwo.\nThree.\n>>>\n\nRESPONSE\n<<<\nThe meeting is at six.\n>>>\n\nCLAIM\n<<<\nThe reply names a time\n>>>"
      }
    },
    {
      "id": "assertion-call-coherent-run-facts-then-call-facts",
      "description": "Call facts follow the run's facts.",
      "input": {
        "assertion": "coherent",
        "facts": ["Run fact."],
        "args": [
          "The meeting is at six.",
          "The reply names a time",
          {
            "facts": "Call fact."
          }
        ]
      },
      "expect": {
        "text": "STATE\n<<<\nRun fact.\nCall fact.\n>>>\n\nRESPONSE\n<<<\nThe meeting is at six.\n>>>\n\nCLAIM\n<<<\nThe reply names a time\n>>>"
      }
    },
    {
      "id": "assertion-call-coherent-run-facts-empty-array",
      "description": "A facts call with an empty array adds nothing.",
      "input": {
        "assertion": "coherent",
        "facts": [[]],
        "args": ["The meeting is at six.", "The reply names a time"]
      },
      "expect": {
        "text": "RESPONSE\n<<<\nThe meeting is at six.\n>>>\n\nCLAIM\n<<<\nThe reply names a time\n>>>"
      }
    },
    {
      "id": "assertion-call-coherent-empty-strings",
      "description": "Empty response and claim strings are valid.",
      "input": {
        "assertion": "coherent",
        "args": ["", ""]
      },
      "expect": {
        "text": "RESPONSE\n<<<\n\n>>>\n\nCLAIM\n<<<\n\n>>>"
      }
    },
    {
      "id": "assertion-call-coherent-ignores-test-strict",
      "description": "A coherent call has no mode; the test's strict does not change it.",
      "input": {
        "assertion": "coherent",
        "strict": true,
        "args": ["The meeting is at six.", "The reply names a time"]
      },
      "expect": {
        "text": "RESPONSE\n<<<\nThe meeting is at six.\n>>>\n\nCLAIM\n<<<\nThe reply names a time\n>>>"
      }
    },
    {
      "id": "assertion-call-coherent-actual-number",
      "description": "A number as the response is a usage error.",
      "input": {
        "assertion": "coherent",
        "args": [42, "The reply names a time"]
      },
      "expect": {
        "error": {
          "kind": "usage"
        }
      }
    },
    {
      "id": "assertion-call-coherent-actual-null",
      "description": "Null as the response is a usage error.",
      "input": {
        "assertion": "coherent",
        "args": [null, "The reply names a time"]
      },
      "expect": {
        "error": {
          "kind": "usage"
        }
      }
    },
    {
      "id": "assertion-call-coherent-actual-unset",
      "description": "An unset response is a usage error.",
      "input": {
        "assertion": "coherent",
        "args": [
          {
            "$special": "undefined"
          },
          "The reply names a time"
        ]
      },
      "expect": {
        "error": {
          "kind": "usage"
        }
      }
    },
    {
      "id": "assertion-call-coherent-expectation-missing",
      "description": "A missing claim is a usage error.",
      "input": {
        "assertion": "coherent",
        "args": ["The meeting is at six."]
      },
      "expect": {
        "error": {
          "kind": "usage"
        }
      }
    },
    {
      "id": "assertion-call-coherent-expectation-object",
