{
  "area": "verdict",
  "operation": "measure",
  "description": "Measure a test instead of gating it: its pass rate over settled runs, the likely range of the true rate, and the gate suggested for its own runs and for 50 runs.",
  "cases": [
    {
      "id": "verdict-measure-design-example",
      "description": "44 of 50 at gate 10 runs: range 0.75 to 0.96, below a 0.9 target; the suggested gate is 6 of 10, and a sharper 37 of 50 catches more of a drop.",
      "input": {
        "threshold": 0.9,
        "gateRuns": 10,
        "statuses": {
          "passed": 44,
          "failed": 6
        }
      },
      "expect": {
        "value": {
          "outcome": "measured",
          "passed": 44,
          "failed": 6,
          "errored": 0,
          "settled": 50,
          "rate": 0.88,
          "low": 0.75,
          "high": 0.96,
          "need": 45,
          "meetsTarget": false,
          "suggestion": {
            "runs": 10,
            "need": 6,
            "threshold": 0.6,
            "drop": 0.78,
            "caught": 5
          },
          "sharper": {
            "runs": 50,
            "need": 37,
            "threshold": 0.74,
            "drop": 0.78,
            "caught": 19
          }
        }
      }
    },
