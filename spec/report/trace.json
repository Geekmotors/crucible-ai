      }
    },
    {
      "id": "report-trace-provider-request",
      "description": "A provider request names provider, model, system prompt length and meta keys, then the prompt with its length on an indented line; multi-line prompts stay indented.",
      "input": {
        "settings": {
          "verbosity": "debug",
          "provider": "openrouter",
          "model": "test/model",
          "meta": { "x-title": "secret title" },
          "testDefaults": {},
          "excerptChars": 500
        },
        "events": [
          {
            "run": 2,
            "event": "provider-request",
            "provider": "openrouter",
            "model": "test/model",
            "system": "You are a judge.",
            "meta": { "user": "u1", "x": 1 },
            "prompt": "RESPONSE\n<<<\nhi\n>>>",
            "attempt": 1
          }
        ]
      },
      "expect": {
        "text": "[crucible:debug] engine init: verbosity debug, trace written to stdout\n[crucible:debug] config resolved: provider \"openrouter\", model \"test/model\", meta keys [x-title] (values not shown), testDefaults {}, excerptChars 500\n[crucible:debug] run #2 provider request attempt 1 to \"openrouter\": model \"test/model\", system prompt 16 chars, meta keys [user, x]\n    prompt (19 chars): RESPONSE\n    <<<\n    hi\n    >>>\n"
      }
    },
