    {
      "id": "report-trace-provider-failure-retry",
      "description": "A retryable failure states the backoff in whole milliseconds, rounding half up.",
      "input": {
        "settings": {
          "verbosity": "debug",
          "provider": "openrouter",
          "model": "test/model",
          "meta": { "x-title": "secret title" },
          "testDefaults": {},
          "excerptChars": 500
        },
        "events": [
          {
            "event": "provider-failure",
            "attempt": 1,
            "cause": { "name": "ProviderError", "message": "429 Too Many Requests" },
            "next": "retry",
            "delayMs": 1500
          },
          {
            "event": "provider-failure",
            "attempt": 2,
            "cause": { "name": "Error", "message": "503" },
            "next": "retry",
            "delayMs": 1234.5
          },
          {
            "event": "provider-failure",
            "attempt": 3,
            "cause": { "name": "Error", "message": "503" },
            "next": "retry",
            "delayMs": 999.4
          }
        ]
      },
      "expect": {
        "text": "[crucible:debug] engine init: verbosity debug, trace written to stdout\n[crucible:debug] config resolved: provider \"openrouter\", model \"test/model\", meta keys [x-title] (values not shown), testDefaults {}, excerptChars 500\n[crucible:debug] provider attempt 1 failed (retryable, retrying in 1500 ms): ProviderError: 429 Too Many Requests\n[crucible:debug] provider attempt 2 failed (retryable, retrying in 1235 ms): Error: 503\n[crucible:debug] provider attempt 3 failed (retryable, retrying in 999 ms): Error: 503\n"
      }
    },
