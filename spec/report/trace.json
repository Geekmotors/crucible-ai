{
  "area": "report",
  "operation": "trace",
  "description": "Renders the debug trace written for a sequence of trace events.",
  "cases": [
    {
      "id": "report-trace-default-is-silent",
      "description": "Below debug verbosity the trace writes nothing, for any event.",
      "input": {
        "settings": {
          "verbosity": "default",
          "provider": "openrouter",
          "model": "test/model",
          "meta": { "x-title": "secret title" },
          "testDefaults": {},
          "excerptChars": 500
        },
        "events": [
          { "event": "test-started", "runs": 10, "threshold": 0.9, "deadlineMs": 39000 },
          {
            "run": 1,
            "event": "provider-request",
            "provider": "openrouter",
            "model": "m",
            "prompt": "p",
            "attempt": 1
          },
          { "run": 1, "event": "provider-response", "attempt": 1, "reply": "r" },
          {
            "run": 1,
            "event": "provider-failure",
            "attempt": 1,
            "cause": { "name": "Error", "message": "401" },
            "next": "fatal"
          },
          {
            "run": 1,
            "event": "judge-reply-rejected",
            "ask": 1,
            "cause": { "name": "Error", "message": "bad" }
          },
          {
            "run": 1,
            "event": "judge-recorded",
            "call": {
              "verdict": {
                "claim": "c",
                "verdict": true,
                "reasoning": "The response contradicts the claim.",
                "response": "The response text."
              }
            }
          },
          { "event": "run-settled", "number": 1, "status": "passed" },
          {
            "event": "verdict-reached",
            "outcome": "passed",
            "need": 1,
            "passed": 1,
            "failed": 0,
            "errored": 0,
            "runs": 1
          },
          {
            "event": "test-aborted",
            "cause": { "name": "Error", "message": "fatal" },
            "discarded": 1
          },
          { "event": "test-expired", "deadlineMs": 1000, "discarded": 1 }
        ]
      },
      "expect": { "text": "" }
    },
