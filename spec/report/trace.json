    {
      "id": "report-trace-header-once",
      "description": "The first line written opens with the engine and resolved-config header, once.",
      "input": {
        "settings": {
          "verbosity": "debug",
          "provider": "openrouter",
          "model": "test/model",
          "meta": { "x-title": "secret title" },
          "testDefaults": {},
          "excerptChars": 500
        },
        "events": [
          { "event": "test-started", "runs": 10, "threshold": 0.9, "deadlineMs": 39000 },
          { "event": "test-expired", "deadlineMs": 39000, "discarded": 0 }
        ]
      },
      "expect": {
        "text": "[crucible:debug] engine init: verbosity debug, trace written to stdout\n[crucible:debug] config resolved: provider \"openrouter\", model \"test/model\", meta keys [x-title] (values not shown), testDefaults {}, excerptChars 500\n[crucible:debug] test started: 10 run(s) at threshold 0.9, deadline 39000 ms\n[crucible:debug] test deadline of 39000 ms expired; 0 in-flight run(s) discarded\n"
      }
    },
    {
      "id": "report-trace-meta-keys-only",
      "description": "Meta keys are listed in order; their values are never written.",
      "input": {
        "settings": {
          "verbosity": "debug",
          "provider": "openrouter",
          "model": "test/model",
          "meta": { "HTTP-Referer": "https://secret.example", "X-Title": "secret" },
          "testDefaults": {},
          "excerptChars": 500
        },
        "events": [{ "event": "test-started", "runs": 10, "threshold": 0.9, "deadlineMs": 39000 }]
      },
      "expect": {
        "text": "[crucible:debug] engine init: verbosity debug, trace written to stdout\n[crucible:debug] config resolved: provider \"openrouter\", model \"test/model\", meta keys [HTTP-Referer, X-Title] (values not shown), testDefaults {}, excerptChars 500\n[crucible:debug] test started: 10 run(s) at threshold 0.9, deadline 39000 ms\n"
      }
    },
