{
  "$schema": "./surface.schema.json",
  "description": "Every public item a Crucible port provides, each pinned by fixture cases. spec/PORTING.md explains how a port uses it; the TypeScript coverage check (src/core/spec-surface.test.ts) fails when an item has no fixture, a cited case does not exercise it, or the TypeScript surface and this list differ.",
  "operations": [
    { "name": "run-options/resolve", "docs": "spec/README.md#run-options--resolve" },
    { "name": "run-options/validate", "docs": "spec/README.md#run-options--validate" },
    { "name": "verdict/compute", "docs": "spec/README.md#verdict--compute" },
    { "name": "payload/coherent", "docs": "spec/README.md#payload--coherent" },
    { "name": "payload/extract", "docs": "spec/README.md#payload--extract" },
    { "name": "report/render", "docs": "spec/README.md#report--render" },
    { "name": "report/trace", "docs": "spec/README.md#report--trace" },
    { "name": "jsonc/parse", "docs": "spec/README.md#jsonc--parse" },
    { "name": "config/load", "docs": "spec/README.md#config--load" },
    { "name": "provider/request", "docs": "spec/README.md#provider--request" },
    { "name": "provider/response", "docs": "spec/README.md#provider--response" },
    {
      "name": "provider/plain-http-warning",
      "docs": "spec/README.md#provider--plain-http-warning"
    },
    { "name": "judge/reply", "docs": "spec/README.md#judge--reply" },
    { "name": "assertion/call", "docs": "spec/README.md#assertion--call" }
  ],
  "functions": [
    {
      "name": "crucible.it",
      "docs": "docs/api.md#crucibleit",
      "summary": "Registers one runner test whose body runs `runs` times concurrently and passes when at least `threshold` of the runs pass; throws the verdict error with the report otherwise.",
      "fixtures": [
        "run-options-validate-test-runs-zero",
        "run-options-resolve-every-layer",
        "verdict-compute-default-gate-passes",
        "report-render-failed-verdict"
      ],
      "portTests": "Argument forms (options, trailing timeout, two bodies, an argument after the timeout, a trailing timeout beside testTimeout), registration with the runner, the runner timeout it is given, variants and blocked variants, concurrency, deadline, fatal abort and discarded runs."
    },
    {
      "name": "crucible.describe",
      "docs": "docs/api.md#crucibledescribe",
      "summary": "Registers a runner group whose options every crucible.it inside inherits, field by field.",
      "fixtures": [
        "run-options-validate-group-runs-zero",
        "run-options-resolve-inner-group-over-outer"
      ],
      "portTests": "Argument forms, synchronous callback (a returned value or promise is a usage error), settings reaching nested and plain runner groups, no leak into sibling groups, variants and blocked variants."
    },
    {
      "name": "crucible.gate",
      "docs": "docs/api.md#cruciblegate",
      "summary": "Wraps a body into a test function for the runner's own it/test with the same runs, verdict and report as crucible.it.",
      "fixtures": [
        "run-options-validate-test-every-field",
        "run-options-resolve-test-over-group",
        "verdict-compute-strict-gate-errored"
      ],
      "portTests": "Argument forms, forwarding the runner's arguments after t, a function the runner never treats as a done-callback, groups captured when the gate is called."
    },
    {
      "name": "crucible.coherent",
      "docs": "docs/api.md#cruciblecoherent",
      "summary": "Asks the judge whether a response is consistent with a claim given the run's facts; resolves to the verdict.",
      "fixtures": [
        "assertion-call-coherent-arguments-only",
        "assertion-call-coherent-actual-number",
        "payload-coherent-run-facts-then-call-facts",
        "judge-reply-coherent-true"
      ],
      "portTests": "Usable only inside a running test body (usage error elsewhere), inference timeout, the call recorded for the report."
    },
    {
      "name": "crucible.extract",
      "docs": "docs/api.md#crucibleextract",
      "summary": "Asks the judge for the one value a text commits to, typed as asked, or null.",
      "fixtures": [
        "assertion-call-extract-arguments-only",
        "assertion-call-extract-text-number",
        "payload-extract-strict-number",
        "judge-reply-extract-number"
      ],
      "portTests": "Usable only inside a running test body, inference timeout, the call recorded for the report."
    },
    {
      "name": "crucible.facts",
      "docs": "docs/api.md#cruciblefacts",
      "summary": "Adds facts to the current run, in order; every later judge call of the run sends them as STATE.",
      "fixtures": [
        "assertion-call-coherent-run-facts",
        "assertion-call-facts-number",
        "payload-coherent-run-facts"
      ],
      "portTests": "Facts are per run (concurrent runs never share them), copied, append-only, and a usage error outside a running test body."
    },
    {
      "name": "crucible.load",
      "docs": "docs/api.md#crucibleload-and-crucibleappend-deprecated",
      "summary": "Deprecated alias of crucible.facts.",
      "fixtures": ["payload-coherent-run-facts"]
    },
    {
      "name": "crucible.append",
      "docs": "docs/api.md#crucibleload-and-crucibleappend-deprecated",
      "summary": "Deprecated alias of crucible.facts.",
      "fixtures": ["payload-coherent-run-facts"]
    },
    {
      "name": "t.facts",
      "docs": "docs/api.md#the-run-context-t",
      "summary": "crucible.facts bound to one run.",
      "fixtures": ["payload-coherent-run-facts"],
      "portTests": "Works from callbacks that lost the async context; a usage error once its run has ended."
    },
    {
      "name": "t.coherent",
      "docs": "docs/api.md#the-run-context-t",
      "summary": "crucible.coherent bound to one run.",
      "fixtures": ["payload-coherent-run-facts-then-call-facts"],
      "portTests": "Works from callbacks that lost the async context; rejects with a usage error once its run has ended."
    },
    {
      "name": "t.extract",
      "docs": "docs/api.md#the-run-context-t",
      "summary": "crucible.extract bound to one run.",
      "fixtures": ["payload-extract-run-facts-then-call-facts"],
      "portTests": "Works from callbacks that lost the async context; rejects with a usage error once its run has ended."
    }
  ],
