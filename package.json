{
  "name": "crucible-ai",
  "version": "0.2.0",
  "description": "Coherence testing for LLM-integrated code",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Geekmotors/crucible-ai.git"
  },
  "homepage": "https://github.com/Geekmotors/crucible-ai#readme",
  "bugs": {
    "url": "https://github.com/Geekmotors/crucible-ai/issues"
  },
  "keywords": [
    "llm",
    "testing",
    "jest",
    "semantic-assertion",
    "llm-as-a-judge",
    "evals",
    "non-deterministic",
    "reliability",
    "openrouter"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "schemas/*.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "build": "tsdown",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:pack": "node scripts/verify-pack.mjs"
  },
  "peerDependencies": {
    "jest": "^30.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@jest/globals": "^30.4.1",
    "@types/node": "^22.18.0",
    "eslint": "^9.39.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "tsdown": "^0.22.14",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
